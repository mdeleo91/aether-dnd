# ─── Supabase (client) ────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
# These are exposed to the browser (anon key is safe to expose by design).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# ─── AI backend (server-only — used by /api/cogm and /api/generate) ───
# Powers BOTH the co-DM chat AND the in-app content generators (NPCs, shop
# stock, roll tables, encounters). Do NOT prefix with VITE_ (would leak to the
# browser). Without AI_API_KEY: co-DM uses scripted demo replies and the
# generators show a "set AI_API_KEY to generate" state (no hardcoded content).
AI_API_KEY=
AI_PROVIDER=openai          # 'openai' or 'anthropic'
AI_MODEL=                   # optional; default gpt-4o-mini / claude-3-5-haiku-latest
