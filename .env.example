# ─── Supabase (client) ────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
# These are exposed to the browser (anon key is safe to expose by design).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# ─── AI co-DM backend (server-only — used by /api/cogm) ───────────────
# Do NOT prefix these with VITE_ (that would leak the key to the browser).
# Leave AI_API_KEY unset to keep the co-DM in scripted demo mode.
AI_API_KEY=
AI_PROVIDER=openai          # 'openai' or 'anthropic'
AI_MODEL=                   # optional; default gpt-4o-mini / claude-3-5-haiku-latest
